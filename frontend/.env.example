# Backend API URL (required for Electron production builds and Capacitor iOS)
# Set this to your deployed Render backend, e.g.:
#   https://calendar-api.onrender.com
#
# Copy this file to .env.production and fill in your value before building:
#   cp .env.example .env.production
VITE_API_URL=https://your-backend.onrender.com

# Clerk auth (get from https://clerk.com → your app → API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
