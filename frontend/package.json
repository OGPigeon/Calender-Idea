{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "electron:dist:mac": "vite build && electron-builder --mac",
    "electron:dist:win": "vite build && electron-builder --win",
    "cap:prepare": "npm run build && npx cap sync",
    "cap:ios": "npx cap open ios",
    "cap:add:ios": "npx cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@clerk/clerk-react": "^5.61.8",
    "axios": "^1.16.1",
    "date-fns": "^4.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.mycalendar.app",
    "productName": "My Calendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis"
        }
      ]
    }
  }
}
